DATABASE_URL=sqlite+aiosqlite:///./microblogging.sqlite3
ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
MEDIA_DIR=media
MAX_REQUEST_BYTES=65536
LOG_FILE=logs/backend.log
LOG_LEVEL=INFO
CACHE_URL=
BROKER_URL=
PASSWORD_HASH_CONCURRENCY=4
IMAGE_PROCESSING_CONCURRENCY=2
VIDEO_PROCESSING_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
REGISTRATION_RATE_PER_MINUTE=30
POSTS_PER_MINUTE=10
UPLOAD_BYTES_PER_DAY=524288000
